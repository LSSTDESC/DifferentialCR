<FIELD ID="col_1" datatype="double" name="altitude" unit="deg">
<DESCRIPTION>Altitude of focal plane center at the middle of the visit.</DESCRIPTION>
</FIELD>
<FIELD ID="col_2" datatype="double" name="azimuth" unit="deg">
<DESCRIPTION>Azimuth of focal plane center at the middle of the visit.</DESCRIPTION>
</FIELD>
<FIELD ID="col_3" arraysize="*" datatype="char" name="band">
<DESCRIPTION>Name of the band used to take the visit where this source was measured. Abstract filter that is not associated with a particular instrument.</DESCRIPTION>
</FIELD>
<FIELD ID="col_4" datatype="double" name="dec" unit="deg">
<DESCRIPTION>Declination of focal plane center</DESCRIPTION>
</FIELD>
<FIELD ID="col_5" datatype="double" name="expTime" unit="s">
<DESCRIPTION>Spatially-averaged duration of visit, accurate to 10ms.</DESCRIPTION>
</FIELD>
<FIELD ID="col_6" datatype="double" name="ra" unit="deg">
<DESCRIPTION>Right Ascension of focal plane center.</DESCRIPTION>
</FIELD>
<FIELD ID="col_7" datatype="double" name="skyRotation" unit="deg">
<DESCRIPTION>Sky rotation angle.</DESCRIPTION>
</FIELD>
<FIELD ID="col_8" datatype="long" name="visit" ucd="meta.id;obs.image">
<DESCRIPTION>Unique identifier.</DESCRIPTION>
</FIELD>
<FIELD ID="col_9" datatype="double" name="zenithDistance" unit="deg">
<DESCRIPTION>Zenith distance at the middle of the visit.</DESCRIPTION>
</FIELD>
<FIELD ID="col_10" datatype="double" name="expMidptMJD" ucd="time.epoch;obs.exposure" unit="d">
<DESCRIPTION>Midpoint time for exposure at the fiducial center of the focal plane array in MJD. TAI, accurate to 10ms.</DESCRIPTION>
</FIELD>
